        <SQLTask:SqlTaskData
          SQLTask:Connection="{A17C9270-7B06-4CE6-8F8A-7F0D4D9F2F81}"
          SQLTask:SqlStatementSource="EXEC dbo.usp_etl_01_extraer_staging;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02 Transformar y cargar dim_tiempo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Normaliza fecha y hora y carga la dimensión de tiempo."
