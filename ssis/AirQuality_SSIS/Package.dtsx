    <DTS:Executable
      DTS:refId="Package\01 Extracción CSV a Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Extrae el CSV original y lo carga en la tabla staging."
      DTS:DTSID="{B0B44D10-5012-4CE8-BE2A-BD13E1F32A3B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 Extracción CSV a Staging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A17C9270-7B06-4CE6-8F8A-7F0D4D9F2F81}"
          SQLTask:SqlStatementSource="EXEC dbo.usp_etl_01_extraer_staging;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\02 Transformar y cargar dim_tiempo" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Normaliza fecha y hora y carga la dimensión de tiempo." DTS:DTSID="{F4E6B7A9-9E1B-4E5F-8B2F-4F2F2EAA2D11}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="02 Transformar y cargar dim_tiempo" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{A17C9270-7B06-4CE6-8F8A-7F0D4D9F2F81}" SQLTask:SqlStatementSource="EXEC dbo.usp_etl_02_cargar_dim_tiempo;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" /></DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\03 Transformar y cargar hecho_calidad_aire" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Convierte valores, calcula banda CO y carga la tabla de hechos." DTS:DTSID="{D4A9E0C2-9D14-4B01-86E7-83F2F4F8C109}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="03 Transformar y cargar hecho_calidad_aire" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{A17C9270-7B06-4CE6-8F8A-7F0D4D9F2F81}" SQLTask:SqlStatementSource="EXEC dbo.usp_etl_03_cargar_hecho;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" /></DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Validar carga del Data Mart"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Comprueba que la carga terminó sin duplicados."
      DTS:DTSID="{C8D8E1B4-C1B7-4F80-9D34-1CE9E7C1A3A0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Validar carga del Data Mart"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A17C9270-7B06-4CE6-8F8A-7F0D4D9F2F81}"
          SQLTask:SqlStatementSource="IF (SELECT COUNT(*) FROM dbo.hecho_calidad_aire) &lt;&gt; (SELECT COUNT(DISTINCT medicion_id) FROM dbo.hecho_calidad_aire) THROW 51000, 'Se detectaron duplicados en la tabla de hechos.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
