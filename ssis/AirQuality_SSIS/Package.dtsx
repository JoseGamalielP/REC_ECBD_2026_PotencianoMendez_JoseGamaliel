  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01 Extracción CSV a Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Extrae el CSV original y lo carga en la tabla staging."
      DTS:DTSID="{B0B44D10-5012-4CE8-BE2A-BD13E1F32A3B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
